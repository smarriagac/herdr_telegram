  "cards": [
    {
      "dot": "cyan",
      "title": "Clean Architecture Core",
      "items": [
        "Hexagonal (Ports & Adapters) design with zero third-party pip dependencies",
        "BotController authenticates incoming messages against whitelist before routing",
        "Domain models and interfaces remain decoupled from CLI and transport protocols"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Engine Desktop & Terminal",
      "items": [
        "CompositeDriver automatically resolves whether an agent runs in Desktop or Terminal",
        "Herdr Desktop drives the GPUI GUI window via 'herdr-app do' and 'herdr-core' ('hc')",
        "Herdr Classic multiplexer connects through 'herdr.sock' and workspace commands"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-Database Session Persistence",
      "items": [
        "Agent UUIDs ('session_id') are tracked from runtime process metadata",
        "Reinvoking with '--conversation <session_id>' natively restores full chat history",
        "Atomic 'topics.json' binds persistent Telegram Forum Topics to workspace state"
      ]
    }
  ]
